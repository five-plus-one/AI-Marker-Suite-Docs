{
  "name": "ai-marker-suite-docs",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@10.9.9",
  "description": "AI-Marker-Suite 文档站",
  "scripts": {
    "dev": "npm run build && vitepress preview --host 127.0.0.1",
    "build": "node site/refresh-releases.mjs && node site/build-preview.mjs && vitepress build && node site/build.mjs",
    "preview": "vitepress preview",
    "indexnow": "node scripts/submit-indexnow.cjs",
    "check:http": "node site/verify-preview.mjs",
    "check": "node site/verify.mjs && node site/verify-seo.mjs && node site/verify-discovery.mjs"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.2",
    "markdown-it-mathjax3": "^4.3.2",
    "vitepress": "^1.6.3"
  },
  "dependencies": {
    "@fiveplusone/ui": "file:site/vendor/fiveplusone-ui-0.5.93.tgz",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
